{
  "servers": [
    {
      "name": "filesystem",
      "transport": "stdio",
      "enabled": true,
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "./workspace"]
    },
    {
      "name": "git",
      "transport": "stdio",
      "enabled": true,
      "command": "python",
      "args": ["-m", "mcp_server_git"]
    },
    {
      "name": "pharmacy",
      "transport": "stdio",
      "enabled": false,
      "command": "python",
      "args": ["-m", "src.servers.pharmacy.stdio_server"]
    },
    {
      "name": "pharmacy-remote",
      "transport": "http",
      "enabled": true,
      "url": "${PHARMACY_REMOTE_URL}"
    }
  ]
}
