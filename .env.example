# Anthropic Messages API key (you can use other LLM providers, 
# but this is the one we use in the demo)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for the host's LLM calls.
ANTHROPIC_MODEL=claude-sonnet-4-5

# Base URL for the pharmacy MCP server once deployed remotely (Streamable HTTP).
PHARMACY_REMOTE_URL=https://your-cloud-run-service.a.run.app/mcp
